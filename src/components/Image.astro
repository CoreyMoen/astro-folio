---
import { Image as AstroImage, Picture as AstroPicture } from "astro:assets";
import type { LocalImageProps, RemoteImageProps } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

type ImageVariant = "responsive" | "densities" | "fixed";

interface Props extends Omit<
  HTMLAttributes<"img">,
  "src" | "width" | "height"
> {
  /** An imported asset, or a URL for a remote image. Nothing is output if it is missing. */
  src: ImageMetadata | string;
  /** Leave unset on decorative images — renders `alt=""`. */
  alt?: string;
  /** Render `<picture>` with multiple formats instead of a single `<img>`. Ignored for SVG sources. */
  picture?: boolean;
  /**
   * How the browser chooses a source.
   *
   * - `responsive` — one source per screen width (default)
   * - `densities` — one source per pixel density, for fixed-size art
   * - `fixed` — a single source, no `srcset`
   */
  variant?: ImageVariant;
  /** Overrides the size Astro infers from the source. */
  width?: number;
  /** Overrides the size Astro infers from the source. */
  height?: number;
  /** Widths to generate for `variant="responsive"`. Astro picks sensible ones by default. */
  widths?: number[];
  /** Densities to generate for `variant="densities"`. Defaults to `[1, 2]`. */
  densities?: (number | `${number}x`)[];
  /** `sizes` attribute, paired with `widths`. */
  sizes?: string;
  /** Output quality — a preset such as `"high"`, or a number from 0 to 100. */
  quality?: LocalImageProps["quality"];
  /** Output format. Defaults to `webp`, or `svg` passthrough for SVG sources. */
  format?: LocalImageProps["format"];
  /** Formats to offer when `picture` is set. */
  formats?: NonNullable<LocalImageProps["format"]>[];
  /** For logos and cutouts: never crop, and drop the skeleton tint. */
  transparent?: boolean;
}

const {
  src,
  alt: altProp,
  picture = false,
  variant = "responsive",
  width,
  height,
  widths,
  densities,
  sizes,
  quality,
  format,
  formats,
  transparent = false,
  class: className,
  ...attrs
} = Astro.props;

const alt = altProp ?? "";

if (import.meta.env.DEV && !src) {
  console.warn("[lumos] <Image> rendered without a `src`; nothing was output.");
}

const isSvg =
  typeof src === "string" ? /\.svg(\?|#|$)/i.test(src) : src?.format === "svg";
const resolvedFormat = format ?? (isSvg ? "svg" : undefined);

const usePicture = picture && !isSvg;

const hasExplicitSize = width !== undefined || height !== undefined;
const sizing =
  typeof src === "string" && !hasExplicitSize
    ? { inferSize: true as const }
    : { width, height };

const srcset =
  variant === "densities"
    ? { densities: densities ?? [1, 2] }
    : { widths, sizes, layout: variant === "fixed" ? "none" : "constrained" };

const shared = {
  src,
  alt,
  quality,
  format: resolvedFormat,
  ...sizing,
  ...srcset,
  ...attrs,
  "class:list": [
    "image",
    transparent && "image--transparent",
    variant === "fixed" && "image--fixed",
    className,
  ],
} as unknown as LocalImageProps | RemoteImageProps;
---

{
  src &&
    (usePicture ? (
      <AstroPicture {...shared} formats={formats} />
    ) : (
      <AstroImage {...shared} />
    ))
}
