---
import type { HTMLAttributes } from "astro/types";

type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
type HeadingStyle =
  | "inherit"
  | "display"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "large"
  | "main"
  | "small";

interface Props extends HTMLAttributes<"div"> {
  tag?: HeadingTag;
  variant?: HeadingStyle;
  maxWidth?: number;
}

const {
  tag = "h2",
  variant = tag,
  maxWidth,
  class: className,
  ...rest
} = Astro.props;

const Tag = tag;
---

<div
  class:list={[
    "heading",
    variant !== "inherit" && `text-style-${variant}`,
    className,
  ]}
  style={maxWidth ? `--_max-width: ${maxWidth}ch;` : undefined}
  {...rest}
>
  <Tag>
    <slot />
  </Tag>
</div>
