---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
type HeadingStyle =
  | "inherit"
  | "display"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "large"
  | "main"
  | "small";

interface Props extends HTMLAttributes<"div"> {
  /** Skip rendering this component and its children entirely. */
  noRender?: boolean;
  tag?: HeadingTag;
  variant?: HeadingStyle;
  maxWidth?: number;
}

const {
  noRender = false,
  tag = "h2",
  variant = tag,
  maxWidth,
  class: className,
  ...rest
} = Astro.props;

const Tag = tag;

const content = await slotContent(Astro.slots);
---

{
  !noRender && content && (
    <Tag
      class:list={[
        "heading",
        variant !== "inherit" && `text-style-${variant}`,
        className,
      ]}
      style={maxWidth ? `--_mw: ${maxWidth}ch;` : undefined}
      {...rest}
    >
      <slot />
    </Tag>
  )
}
