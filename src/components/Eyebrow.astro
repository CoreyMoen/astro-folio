---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Show the marker before the text. */
  marker?: boolean;
}

const { marker = true, class: className, ...rest } = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  content && (
    <div class:list={["eyebrow_wrap", className]} {...rest}>
      {marker && <span class="eyebrow_marker" aria-hidden="true" />}
      <p class="eyebrow_text text-style-small">
        <slot />
      </p>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);
    }

    .eyebrow_marker {
      flex: none;
      width: var(--border-width);
      height: 0.75rem;
      background-color: currentcolor;
    }
  }
</style>
