---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div class:list={["eyebrow_wrap", className]} {...rest}>
      <span class="eyebrow_marker" aria-hidden="true" />
      <p class="eyebrow_text text-style-small">
        <slot />
      </p>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);
    }

    .eyebrow_marker {
      flex: none;
      width: var(--border-width);
      height: 0.75rem;
      background-color: currentcolor;
    }
  }
</style>
