---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type WrapperMargin =
  "none" | "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" | "auto";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  marginTop?: WrapperMargin;
}

const {
  render = true,
  marginTop = "6",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={[
        "button-wrapper",
        marginTop !== "6" && `margin-top-${marginTop}`,
        className,
      ]}
      {...rest}
    >
      <slot />
    </div>
  )
}
