---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type WrapperMargin =
  "none" | "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" | "auto";

interface Props extends HTMLAttributes<"div"> {
  marginTop?: WrapperMargin;
}

const { marginTop = "6", class: className, ...rest } = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  content && (
    <div
      class:list={[
        "button-wrapper",
        marginTop !== "6" && `margin-top-${marginTop}`,
        className,
      ]}
      {...rest}
    >
      <slot />
    </div>
  )
}
