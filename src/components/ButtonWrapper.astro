---
import type { HTMLAttributes } from "astro/types";

type WrapperMargin =
  "none" | "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" | "auto";

interface Props extends HTMLAttributes<"div"> {
  marginTop?: WrapperMargin;
}

const { marginTop = "6", class: className, ...rest } = Astro.props;
---

<div
  class:list={[
    "button-wrapper",
    marginTop !== "6" && `margin-top-${marginTop}`,
    className,
  ]}
  {...rest}
>
  <slot />
</div>
