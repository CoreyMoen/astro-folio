---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Columns below 30rem. The base every larger size falls back to. */
  xsmall?: number;
  /** Columns from 30rem up. Inherits xsmall when unset. */
  small?: number;
  /** Columns from 48rem up. Inherits small when unset. */
  medium?: number;
  /** Columns from 64rem up. Inherits medium when unset. */
  large?: number;
}

const {
  xsmall = 1,
  small,
  medium,
  large,
  class: className,
  ...rest
} = Astro.props;

const slotContent = Astro.slots.has("default")
  ? (await Astro.slots.render("default")).trim()
  : "";

const columns = [
  `--_cols-xs: ${xsmall}`,
  small !== undefined && `--_cols-sm: ${small}`,
  medium !== undefined && `--_cols-md: ${medium}`,
  large !== undefined && `--_cols-lg: ${large}`,
]
  .filter(Boolean)
  .join("; ");
---

{
  slotContent && (
    <div class:list={["grid", className]} style={columns} {...rest}>
      <slot />
    </div>
  )
}

<style is:global>
  @layer components {
    .grid {
      --_cols: var(--_cols-xs);
      --_cols-xs: 1;
      --_cols-sm: var(--_cols-xs);
      --_cols-md: var(--_cols-sm);
      --_cols-lg: var(--_cols-md);
      --_gap-size: var(--site-gutter);
      width: 100%;
      display: grid;
      grid-column-gap: var(--_gap-size);
      grid-row-gap: var(--_gap-size);
      grid-template-columns: repeat(var(--_cols), minmax(0, 1fr));
      @media (width >= 30rem) {
        --_cols: var(--_cols-sm);
      }
      @media (width >= 48rem) {
        --_cols: var(--_cols-md);
      }
      @media (width >= 64rem) {
        --_cols: var(--_cols-lg);
      }
    }
  }
</style>
