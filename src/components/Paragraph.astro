---
import type { HTMLAttributes } from "astro/types";

type ParagraphTag = "p" | "span" | "div";
type ParagraphStyle =
  | "inherit"
  | "display"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "large"
  | "main"
  | "small";

interface Props extends HTMLAttributes<"p"> {
  tag?: ParagraphTag;
  variant?: ParagraphStyle;
  maxWidth?: number;
}

const {
  tag = "p",
  variant = "inherit",
  maxWidth,
  class: className,
  ...rest
} = Astro.props;

const Tag = tag;
---

<div
  class:list={[
    "text",
    variant !== "inherit" && `text-style-${variant}`,
    className,
  ]}
  style={maxWidth ? `--_max-width: ${maxWidth}ch;` : undefined}
  {...rest}
>
  <Tag>
    <slot />
  </Tag>
</div>
