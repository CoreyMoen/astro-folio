---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type ButtonProps = HTMLAttributes<"button"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  variant?: "primary" | "secondary";
  tag?: "button";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  href?: never;
};

type LinkProps = Omit<HTMLAttributes<"a">, "type"> & {
  render?: boolean;
  variant?: "primary" | "secondary";
  tag: "a";
  href?: string;
  type?: never;
  disabled?: never;
};

type Props = ButtonProps | LinkProps;

const {
  render = true,
  variant = "primary",
  tag = "button",
  href,
  type = "button",
  ...rest
} = Astro.props;
const isLink = tag === "a";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <Tag
      class:list={["button", variant !== "primary" && variant]}
      {...tagAttrs}
      {...rest}
    >
      <slot />
    </Tag>
  )
}

<style is:global>
  @layer components {
    .button {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.5em;
      padding: 0.75em 1.5em;
      background-color: var(--button-background);
      color: var(--button-text);
      border: var(--border-width) solid var(--button-border);
      border-radius: 0.5em;
      line-height: 1.2;
      text-decoration: none;
      text-align: center;
      transition:
        background-color 200ms,
        color 200ms,
        border-color 200ms;
      @media (hover: hover) {
        &:hover {
          background-color: var(--button-background-hover);
          color: var(--button-text-hover);
          border-color: var(--button-border-hover);
        }
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
    }
  }
</style>
