---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  href?: string;
  variant?: "primary" | "secondary";
}

const { href, variant = "primary", ...rest } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  class:list={["button", variant !== "primary" && variant]}
  {...href ? { href } : { type: "button" }}
  {...rest}
>
  <slot />
</Tag>

<style is:global>
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 0.5em;
    padding: 0.75em 1.5em;
    background-color: var(--button-background);
    color: var(--button-text);
    border: var(--border-width) solid var(--button-border);
    border-radius: 0.5em;
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
    transition:
      background-color 200ms,
      color 200ms,
      border-color 200ms;
    @media (hover: hover) {
      &:hover {
        background-color: var(--button-background-hover);
        color: var(--button-text-hover);
        border-color: var(--button-border-hover);
      }
    }
    &.secondary {
      --button-background: var(--button-2-background);
      --button-text: var(--button-2-text);
      --button-border: var(--button-2-border);
      --button-background-hover: var(--button-2-background-hover);
      --button-text-hover: var(--button-2-text-hover);
      --button-border-hover: var(--button-2-border-hover);
    }
    &:disabled {
      cursor: not-allowed;
      opacity: 0.5;
    }
  }

</style>
