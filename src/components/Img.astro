---
import { Image } from "astro:assets";
import type { LocalImageProps, RemoteImageProps } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

type ImageVariant = "background" | "contained" | "logo";

type ImageQuality = "low" | "mid" | "high" | "max";

type ImageFormat = "avif" | "webp" | "png" | "jpeg";

type Base = Omit<
  HTMLAttributes<"img">,
  "src" | "width" | "height" | "loading" | "fetchpriority"
> & {
  /**
   * An imported asset, a remote `http(s)` URL, or a path to a file in `public/`.
   *
   * Imports and remote URLs are optimized. Files in `public/` are served as-is —
   * Astro never reads them — so they render at their natural size. Nothing is
   * output if `src` is missing.
   */
  src: ImageMetadata | string;
  /** Leave unset on decorative images — renders `alt=""`. */
  alt?: string;
  /** Overrides the width Astro reads from the source. Omit either dimension and it is inferred. */
  width?: number;
  /** Overrides the height Astro reads from the source. Omit either dimension and it is inferred. */
  height?: number;
  /**
   * Output quality preset. Defaults to the image service's own default.
   *
   * With Astro's default sharp service: `low` is 25, `mid` 50, `high` 80, `max` 100.
   */
  quality?: ImageQuality;
  /** Output format. Defaults to `webp`, or `svg` passthrough for SVG sources. */
  format?: ImageFormat;
  /** For cutouts on any variant: never crop, and drop the skeleton tint. */
  transparent?: boolean;
  /** Defer loading until the image nears the viewport. Set `eager` for anything above the fold. */
  loading?: "lazy" | "eager";
  /** Raise fetch priority. Use on the page's largest above-the-fold image, and only that one. */
  priority?: boolean;
};

type Props = Base &
  (
    | {
        /**
         * What the image is for.
         *
         * - `contained` — scales within its container, for cards and grids (default)
         * - `background` — fills the section behind it
         * - `logo` — natural size, never cropped, no skeleton tint
         */
        variant?: "contained";
        /** How much of the viewport the image covers, when it isn't the full width. */
        sizes?: string;
      }
    | { variant: "background"; sizes?: never }
    | { variant: "logo"; sizes?: never }
  );

type AllProps = Base & {
  variant?: ImageVariant;
  sizes?: string;
};

const {
  src,
  alt: altProp,
  variant = "contained",
  width,
  height,
  sizes,
  quality,
  format,
  transparent = false,
  loading = "lazy",
  priority = false,
  class: className,
  ...attrs
} = Astro.props as AllProps;

const alt = altProp ?? "";

if (import.meta.env.DEV && !src) {
  console.warn("[lumos] <Img> rendered without a `src`; nothing was output.");
}

const isSvg =
  typeof src === "string" ? /\.svg(\?|#|$)/i.test(src) : src?.format === "svg";
const resolvedFormat = format ?? (isSvg ? "svg" : undefined);

const isFetchable = typeof src === "string" && /^https?:\/\//i.test(src);
const hasBothDimensions = width !== undefined && height !== undefined;
const hasEitherDimension = width !== undefined || height !== undefined;
const sizing =
  isFetchable && !hasBothDimensions
    ? { inferSize: true as const, width, height }
    : { width, height };

const isPublicPath = typeof src === "string" && !isFetchable;

if (import.meta.env.DEV && src && (isPublicPath || isSvg)) {
  const inert: string[] = [];
  if (quality !== undefined) inert.push("quality");
  if (format !== undefined) inert.push("format");
  if (isPublicPath && sizes !== undefined) inert.push("sizes");
  if (inert.length) {
    const why = isPublicPath
      ? `files in public/ are served as-is — import from src/assets to optimize`
      : `SVG sources are passed through unoptimized`;
    console.warn(`[lumos] <Img> ignores ${inert.join(", ")}: ${why}.`);
  }
}

if (
  import.meta.env.DEV &&
  src &&
  !isPublicPath &&
  variant === "logo" &&
  !hasEitherDimension
) {
  console.warn(
    `[lumos] <Img variant="logo"> has no width or height, so both densities resolve to the source's own size and each srcset entry points at the same file. Set the size it displays at.`,
  );
}

const srcset =
  variant === "logo"
    ? { densities: [1, 2] }
    : {
        sizes,
        layout: variant === "background" ? "full-width" : "constrained",
      };

const classes = ["image", variant, transparent && "transparent", className];

const shared = {
  src,
  alt,
  quality,
  loading,
  format: resolvedFormat,
  ...(priority ? { fetchpriority: "high" as const } : {}),
  ...sizing,
  ...srcset,
  ...attrs,
  "class:list": classes,
} as unknown as LocalImageProps | RemoteImageProps;
---

{
  src &&
    (isPublicPath ? (
      <img
        src={src as string}
        {...{ alt, width, height, loading }}
        fetchpriority={priority ? "high" : undefined}
        {...attrs}
        class:list={classes}
      />
    ) : (
      <Image {...shared} />
    ))
}
