---
import { Image } from "astro:assets";
import type { LocalImageProps, RemoteImageProps } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

type ImageVariant = "responsive" | "densities" | "fixed";

type ImageQuality = "low" | "mid" | "high" | "max";

type ImageFormat = "avif" | "webp" | "png" | "jpeg";

type Base = Omit<HTMLAttributes<"img">, "src" | "width" | "height"> & {
  /**
   * An imported asset, a remote `http(s)` URL, or a path to a file in `public/`.
   *
   * Imports and remote URLs are optimized. Files in `public/` are served as-is —
   * Astro never reads them — so they render at their natural size. Nothing is
   * output if `src` is missing.
   */
  src: ImageMetadata | string;
  /** Leave unset on decorative images — renders `alt=""`. */
  alt?: string;
  /** Overrides the width Astro reads from the source. Omit either dimension and it is inferred. */
  width?: number;
  /** Overrides the height Astro reads from the source. Omit either dimension and it is inferred. */
  height?: number;
  /**
   * Output quality preset. Defaults to the image service's own default.
   *
   * With Astro's default sharp service: `low` is 25, `mid` 50, `high` 80, `max` 100.
   */
  quality?: ImageQuality;
  /** Output format. Defaults to `webp`, or `svg` passthrough for SVG sources. */
  format?: ImageFormat;
  /** For logos and cutouts: never crop, and drop the skeleton tint. */
  transparent?: boolean;
};

type Props = Base &
  (
    | {
        /**
         * How the browser chooses a source.
         *
         * - `fixed` — a single source, no `srcset` (default)
         * - `responsive` — one source per screen width
         * - `densities` — one source per pixel density, for fixed-size art
         */
        variant?: "fixed";
        widths?: never;
        sizes?: never;
        densities?: never;
      }
    | {
        variant: "responsive";
        /** Widths to generate. Astro picks sensible ones by default. */
        widths?: number[];
        /** `sizes` attribute, paired with `widths`. */
        sizes?: string;
        densities?: never;
      }
    | {
        variant: "densities";
        /** Densities to generate. Defaults to `[1, 2]`. */
        densities?: (number | `${number}x`)[];
        widths?: never;
        sizes?: never;
      }
  );

type AllProps = Base & {
  variant?: ImageVariant;
  widths?: number[];
  sizes?: string;
  densities?: (number | `${number}x`)[];
};

const {
  src,
  alt: altProp,
  variant = "fixed",
  width,
  height,
  widths,
  densities,
  sizes,
  quality,
  format,
  transparent = false,
  class: className,
  ...attrs
} = Astro.props as AllProps;

const alt = altProp ?? "";

if (import.meta.env.DEV && !src) {
  console.warn("[lumos] <Img> rendered without a `src`; nothing was output.");
}

const isSvg =
  typeof src === "string" ? /\.svg(\?|#|$)/i.test(src) : src?.format === "svg";
const resolvedFormat = format ?? (isSvg ? "svg" : undefined);

const isFetchable = typeof src === "string" && /^https?:\/\//i.test(src);
const hasBothDimensions = width !== undefined && height !== undefined;
const hasEitherDimension = width !== undefined || height !== undefined;
const sizing =
  isFetchable && !hasBothDimensions
    ? { inferSize: true as const, width, height }
    : { width, height };

const isPublicPath = typeof src === "string" && !isFetchable;

if (import.meta.env.DEV && src && (isPublicPath || isSvg)) {
  const inert: string[] = [];
  if (quality !== undefined) inert.push("quality");
  if (format !== undefined) inert.push("format");
  if (isPublicPath) {
    if (widths !== undefined) inert.push("widths");
    if (sizes !== undefined) inert.push("sizes");
    if (densities !== undefined) inert.push("densities");
    if (variant !== "fixed") inert.push(`variant="${variant}"`);
  }
  if (inert.length) {
    const why = isPublicPath
      ? `files in public/ are served as-is — import from src/assets to optimize`
      : `SVG sources are passed through unoptimized`;
    console.warn(`[lumos] <Img> ignores ${inert.join(", ")}: ${why}.`);
  }
}

if (
  import.meta.env.DEV &&
  src &&
  !isPublicPath &&
  variant === "densities" &&
  !hasEitherDimension
) {
  console.warn(
    `[lumos] <Img variant="densities"> has no width or height, so every density resolves to the source's own size and each srcset entry points at the same file. Set the size it displays at.`,
  );
}

const srcset =
  variant === "densities"
    ? { densities: densities ?? [1, 2] }
    : { widths, sizes, layout: variant === "fixed" ? "none" : "constrained" };

const classes = [
  "image",
  transparent && "transparent",
  variant === "fixed" && "fixed",
  className,
];

const shared = {
  src,
  alt,
  quality,
  format: resolvedFormat,
  ...sizing,
  ...srcset,
  ...attrs,
  "class:list": classes,
} as unknown as LocalImageProps | RemoteImageProps;
---

{
  src &&
    (isPublicPath ? (
      <img
        src={src as string}
        {...{ alt, width, height }}
        {...attrs}
        class:list={classes}
      />
    ) : (
      <Image {...shared} />
    ))
}
