---
import { Image, Picture } from "astro:assets";
import type { LocalImageProps, RemoteImageProps } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

type ImageVariant = "responsive" | "densities" | "fixed";

type Base = Omit<HTMLAttributes<"img">, "src" | "width" | "height"> & {
  /**
   * An imported asset, a remote `http(s)` URL, or a path to a file in `public/`.
   *
   * Imports and remote URLs are optimized. Files in `public/` are served as-is —
   * Astro never reads them — so they render as a plain `<img>` at their natural
   * size. Nothing is output if `src` is missing.
   */
  src: ImageMetadata | string;
  /** Leave unset on decorative images — renders `alt=""`. */
  alt?: string;
  /** Render `<picture>` with multiple formats instead of a single `<img>`. Ignored for SVG sources. */
  picture?: boolean;
  /** Overrides the width Astro reads from the source. Omit either dimension and it is inferred. */
  width?: number;
  /** Overrides the height Astro reads from the source. Omit either dimension and it is inferred. */
  height?: number;
  /** Output quality — a preset such as `"high"`, or a number from 0 to 100. */
  quality?: LocalImageProps["quality"];
  /** Output format. Defaults to `webp`, or `svg` passthrough for SVG sources. */
  format?: LocalImageProps["format"];
  /** Formats to offer when `picture` is set. */
  formats?: NonNullable<LocalImageProps["format"]>[];
  /** For logos and cutouts: never crop, and drop the skeleton tint. */
  transparent?: boolean;
};

type Props = Base &
  (
    | {
        /** One source per screen width. The default. */
        variant?: "responsive";
        /** Widths to generate. Astro picks sensible ones by default. */
        widths?: number[];
        /** `sizes` attribute, paired with `widths`. */
        sizes?: string;
        densities?: never;
      }
    | {
        /** One source per pixel density, for fixed-size art. */
        variant: "densities";
        /** Densities to generate. Defaults to `[1, 2]`. */
        densities?: (number | `${number}x`)[];
        widths?: never;
        sizes?: never;
      }
    | {
        /** A single source, no `srcset`. */
        variant: "fixed";
        widths?: never;
        sizes?: never;
        densities?: never;
      }
  );

type AllProps = Base & {
  variant?: ImageVariant;
  widths?: number[];
  sizes?: string;
  densities?: (number | `${number}x`)[];
};

const {
  src,
  alt: altProp,
  picture = false,
  variant = "responsive",
  width,
  height,
  widths,
  densities,
  sizes,
  quality,
  format,
  formats,
  transparent = false,
  class: className,
  ...attrs
} = Astro.props as AllProps;

const alt = altProp ?? "";

if (import.meta.env.DEV && !src) {
  console.warn("[lumos] <Img> rendered without a `src`; nothing was output.");
}

const isSvg =
  typeof src === "string" ? /\.svg(\?|#|$)/i.test(src) : src?.format === "svg";
const resolvedFormat = format ?? (isSvg ? "svg" : undefined);

const usePicture = picture && !isSvg;

const isFetchable = typeof src === "string" && /^https?:\/\//i.test(src);
const hasBothDimensions = width !== undefined && height !== undefined;
const sizing =
  isFetchable && !hasBothDimensions
    ? { inferSize: true as const, width, height }
    : { width, height };

const isPublicPath = typeof src === "string" && !isFetchable;

const srcset =
  variant === "densities"
    ? { densities: densities ?? [1, 2] }
    : { widths, sizes, layout: variant === "fixed" ? "none" : "constrained" };

const classes = [
  "image",
  transparent && "image--transparent",
  variant === "fixed" && "image--fixed",
  className,
];

const shared = {
  src,
  alt,
  quality,
  format: resolvedFormat,
  ...sizing,
  ...srcset,
  ...attrs,
  "class:list": classes,
} as unknown as LocalImageProps | RemoteImageProps;
---

{
  src &&
    (isPublicPath ? (
      <img
        src={src as string}
        {...{ alt, width, height }}
        {...attrs}
        class:list={classes}
      />
    ) : usePicture ? (
      <Picture {...shared} formats={formats} />
    ) : (
      <Image {...shared} />
    ))
}
