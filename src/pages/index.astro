---
import Layout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Heading from '@/components/Heading.astro';
import background from '@/assets/background.svg';
import leaves from '@/assets/leaves.png';
import Eyebrow from '@/components/Eyebrow.astro';
import logo from '@/assets/logo.svg';
import arrow_full from '@/assets/icons/arrow-full.svg';
import arrow from '@/assets/icons/arrow.svg';
import close from '@/assets/icons/close.svg';
import pause from '@/assets/icons/pause.svg';
import play from '@/assets/icons/play.svg';
import Img from '@/components/Img.astro';
import lumos_background from '@/assets/lumos-background.svg';
---
<Layout overlap={true}>
  <Section fullHeight={true} align="center" paddingBottom="large" paddingTop="large">
    <Img src={lumos_background} slot="background" />
    <Eyebrow>Lumos Framework</Eyebrow>
    <Heading variant="display" tag="h1">Style Guide</Heading>
    <Eyebrow variant="tag">v0.01</Eyebrow>
  </Section>
</Layout>
