---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import background from "@/assets/background.svg";
---

<Layout>
  <Section align="center" paddingTop="navoverlap" theme="dark" class="min-height-screen">
    <img slot="background" src={background.src} alt="" />
    <Heading tag="h2" variant="display" maxWidth={12}>Home</Heading>
    <Paragraph tag="p" variant="large" maxWidth={45}>
      We build things that help people work smarter, move faster, and grow
      further.
    </Paragraph>
    <ButtonWrapper>
      <Button href="/about">Learn more</Button>
      <Button variant="secondary" type="button">Send</Button>
    </ButtonWrapper>
  </Section>
</Layout>
