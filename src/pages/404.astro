---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Section from "@/components/Section.astro";
import PageHeader from "@/components/site/PageHeader.astro";
---

<SiteLayout
  title="Page not found"
  description="The page you're looking for doesn't exist."
>
  <PageHeader
    title="404"
    intro="The page you're looking for may have moved, or the link that brought you here might be out of date."
  />
  <Section paddingTop="none" align="center" gap="0">
    <a href="/" class="button_wrap">Back to home</a>
  </Section>
</SiteLayout>
