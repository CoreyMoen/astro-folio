{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coreymoen-portfolio",
  "compatibility_date": "2026-08-13",

  // The built site. There is no `main`, so this deploys as an assets-only
  // Worker: Cloudflare serves the files and no script runs per request.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },

  // Add the production domain here once the zone lives in the deploying
  // Cloudflare account, e.g.:
  // "routes": [{ "pattern": "www.coreymoen.com", "custom_domain": true }],

  "observability": {
    "enabled": true,
  },
}
